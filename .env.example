# Copy to .env and fill in real values before running docker compose.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Database (Postgres; required - see appointments/models.py for why) ---
POSTGRES_DB=appointment_hub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# DEV-ONLY: set USE_SQLITE=True to run manage.py commands against local
# SQLite with no Postgres/Docker available (e.g. `manage.py check`,
# `makemigrations`, `test`). Never set this in docker-compose/production -
# the Appointment model's overlap-prevention exclusion constraint is
# Postgres-only and silently degrades (see appointments/models.py and
# common/migration_operations.py) when this is on.
USE_SQLITE=False

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False
WAITLIST_OFFER_EXPIRY_HOURS=2

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api
